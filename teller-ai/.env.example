OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_GENERATION_MODEL=@cf/black-forest-labs/flux-2-klein-4b
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TTS_API_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/functions/55cf67bf-600f-4b04-8eac-12ed39537a08
# Optional server-side WAV file used to seed a user's Postgres voice sample when they have not uploaded one.
# The sample must be 3-10 seconds, mono, 16-bit PCM, and at least 22.05 kHz.
NVIDIA_TTS_VOICE_PROMPT_PATH=
# Optional Fish Audio fallback for speech generation; uses the s2.1-pro-free model.
FISH_API_KEY=

# Google Workspace connection used by CyberMail. Keep secrets server-side.
CYBERMAIL_DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional; defaults to Google's remote Gmail MCP endpoint.
GMAIL_MCP_SERVER_URL=https://gmailmcp.googleapis.com/mcp/v1

# Public browser key for the Google Maps Embed API. Restrict by HTTP referrer and API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# PayPal defaults to Live. Use sandbox only for development/testing.
PAYPAL_ENVIRONMENT=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ZAR_TO_USD_RATE=0.0549
NEXT_PUBLIC_APP_URL=http://localhost:3000
